{
  "rules": {
    "stats": {
      ".read": "auth != null && auth.token.email === 'hermannrichy15@gmail.com' && auth.token.email_verified === true",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-([0-9]{2}-[0-9]{2}|W[0-9]{2}|[0-9]{2})$/)",
        "$name": {
          ".write": "true",
          ".validate": "$name.matches(/^(active|new_device|age_ok|tour_done|pwa_install|in_app|g_cartes|g_quiz|g_ludo|g_tour|g_aov|g_morpion|g_ppc|g_verre|m_local|m_duo|m_distance|room_created|room_joined|room_ended|chat_msg|chat_sticker|chat_voice|chat_react|err_online)$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('players/p0/uid').val() === auth.uid : (data.child('players/p0/uid').val() === auth.uid || data.child('players/p1/uid').val() === auth.uid || !data.child('players/p1').exists()))",
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/) && newData.hasChildren(['code', 'game', 'createdAt', 'players', 'stateJson'])",
        "code": { ".validate": "newData.val() === $code" },
        "game": { ".validate": "newData.isString() && newData.val().length < 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "stateJson": { ".validate": "newData.isString() && newData.val().length < 20000" },
        "live": { ".validate": "newData.isString() && newData.val().length < 2000" },
        "players": {
          "$p": {
            ".validate": "($p === 'p0' || $p === 'p1') && newData.hasChildren(['uid', 'name', 'online'])",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "gender": { ".validate": "newData.val() === 'h' || newData.val() === 'f' || newData.val() === ''" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "keys": {
          "$p": { ".validate": "($p === 'p0' || $p === 'p1') && newData.isString() && newData.val().length < 500" }
        },
        "typing": {
          "$p": { ".validate": "($p === 'p0' || $p === 'p1') && newData.isNumber()" }
        },
        "away": {
          "$p": { ".validate": "($p === 'p0' || $p === 'p1') && newData.isNumber()" }
        },
        "seen": {
          "$p": { ".validate": "($p === 'p0' || $p === 'p1') && newData.isNumber()" }
        },
        "chat": {
          "$id": {
            ".validate": "newData.hasChildren(['f', 'iv', 'ct', 't']) && (newData.child('f').val() === 0 || newData.child('f').val() === 1) && root.child('rooms/' + $code + '/players/p' + newData.child('f').val() + '/uid').val() === auth.uid",
            "f": { ".validate": "newData.isNumber()" },
            "iv": { ".validate": "newData.isString() && newData.val().length < 40" },
            "ct": { ".validate": "newData.isString() && newData.val().length < 500000" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
