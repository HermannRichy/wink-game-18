# En-têtes Cloudflare Pages
# Le service worker et la version doivent toujours être relus (mises à jour de l'app)
/sw.js
  Cache-Control: no-cache
/swe-worker-*
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/manifest.webmanifest
  Cache-Control: no-cache
# Fichiers versionnés par Next : en cache pour toujours
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
